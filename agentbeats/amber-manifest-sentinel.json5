{
  manifest_version: "0.1.0",
  program: {
    image: "ghcr.io/entigram-ai/entigram-sentinel:latest",
    entrypoint: [
      "python",
      "-m",
      "entigram.sentinel_agent",
      "--host",
      "0.0.0.0",
      "--port",
      "9010",
      "--card-url",
      "http://endpoint:9010"
    ],
    env: {
      LOG_LEVEL: "INFO",
      ENTIGRAM_SENTINEL_PROVIDER: "openai",
      OPENAI_API_KEY: "${config.openai_api_key}",
      OPENAI_MODEL: "${config.openai_model}"
    },
    network: {
      endpoints: [{ name: "endpoint", port: 9010 }]
    }
  },
  config_schema: {
    type: "object",
    properties: {
      openai_api_key: { type: "string", secret: true },
      openai_model: { type: "string", default: "gpt-5.2" }
    },
    required: ["openai_api_key"],
    additionalProperties: false
  },
  provides: {
    a2a: { kind: "a2a", endpoint: "endpoint" }
  },
  exports: {
    a2a: "a2a"
  }
}
