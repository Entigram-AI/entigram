{
  manifest_version: "0.1.0",
  program: {
    image: "ghcr.io/entigram-ai/entigram-sentinel:latest",
    entrypoint: [
      "python",
      "-m",
      "entigram.sentinel_agent",
      "--host",
      "0.0.0.0",
      "--port",
      "9010",
      "--card-url",
      "http://endpoint:9010"
    ],
    env: {
      LOG_LEVEL: "INFO",
      CLOUDFLARE_AUTH_TOKEN: "${config.cloudflare_auth_token}",
      CLOUDFLARE_ACCOUNT_ID: "${config.cloudflare_account_id}",
      CLOUDFLARE_MODEL: "${config.cloudflare_model}"
    },
    network: {
      endpoints: [{ name: "endpoint", port: 9010 }]
    }
  },
  config_schema: {
    type: "object",
    properties: {
      cloudflare_auth_token: { type: "string", secret: true },
      cloudflare_account_id: { type: "string", secret: true },
      cloudflare_model: { type: "string", default: "openai/gpt-5.6-terra" }
    },
    required: ["cloudflare_auth_token", "cloudflare_account_id"],
    additionalProperties: false
  },
  provides: {
    a2a: { kind: "a2a", endpoint: "endpoint" }
  },
  exports: {
    a2a: "a2a"
  }
}
